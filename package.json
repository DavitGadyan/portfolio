  "description": "David Gadyan — Full-Stack AI Engineer. Bilingual (EN/ES) static Next.js portfolio for davidgadyan.com.",
  "engines": {
    "node": ">=20.9.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-content-parity.mjs",
    "build": "next build && next-image-export-optimizer && node scripts/postbuild.mjs",
    "postbuild": "node scripts/verify-out.mjs",
    "serve": "serve out -l 4173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lh": "node scripts/lighthouse.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "migrate:hugo": "node scripts/migrate-hugo.mjs /Users/dyada/Desktop/portfolio/david_portfolio"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "next-image-export-optimizer": "^1.21.2",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "lighthouse": "^12.8.2",
    "postcss": "^8.5.32",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
