# Absolute origin used for canonical URLs, sitemap, JSON-LD and llms.txt (include the basePath if any)
NEXT_PUBLIC_SITE_URL=https://davidgadyan.com
# '' on the custom domain; '/portfolio' while served from https://davitgadyan.github.io/portfolio/
NEXT_PUBLIC_BASE_PATH=
# When set, scripts/postbuild.mjs writes out/CNAME. Leave empty until DNS for davidgadyan.com is live.
CUSTOM_DOMAIN=davidgadyan.com
# Optional GA4 measurement id override (defaults to G-VVQQRF2LWE, the davidgadyan.com property, in lib/site.ts); ignored when a GTM container is set
NEXT_PUBLIC_GA_ID=
# Optional Google Tag Manager container. When set, the container replaces the direct GA4 load and owns GA4 + Ads tags.
NEXT_PUBLIC_GTM_ID=
# Optional Google Ads conversion tag, used only without a GTM container (leave empty if unused)
NEXT_PUBLIC_ADS_ID=
NEXT_PUBLIC_ADS_LABEL_LEAD=
NEXT_PUBLIC_ADS_LABEL_BOOKING=
